@@ -633,6 +638,22 @@ function resolveModelCompat(provider, entry, route, base, api) {
 */
 function resolveRouteModels(request, validation = "strict") {
 	const { provider } = request;
+	/* PawWork patch: the OpenCode gateway refuses an inference request that carries
+	no per-conversation id, and the Completions protocol gates those headers behind
+	`sendSessionAffinityHeaders`. That is a fact about the endpoint, not a choice a
+	user makes, so it belongs with the route rather than in their settings document
+	— writing it there would also register the route before they have a key for it,
+	putting its models in the picker where every one of them fails. Drop this once
+	the bundled catalog carries the switch. */
+	if (provider === "opencode-go" && request.compat?.sendSessionAffinityHeaders === void 0) {
+		request = {
+			...request,
+			compat: {
+				...request.compat,
+				sendSessionAffinityHeaders: true
+			}
+		};
+	}
 	const defaults = catalogModels(provider);
 	const providerBaseUrl = catalogProvider(provider)?.baseUrl;
 	const configured = request.models ?? [];
@@ -1374,7 +1395,12 @@ function mapUsage(usage) {
 	};
 }
 function classifyPiAiError(message) {
-	if (/\b(?:401|403)\b/.test(message)) return "AUTH";
+	/* PawWork patch: a 403 says the provider refused the request, not that the
+	credential is wrong, and its body names the reason. AUTH is also the one code
+	the chat client replaces with "API key is invalid", so folding every 403 into
+	it also hides that reason — Zen's free-tier gate reached users as a key problem
+	this way. Drop this once upstream separates refusal from authentication. */
+	if (/\b401\b/.test(message)) return "AUTH";
 	if (isQuotaExceededError(message)) return QUOTA_EXCEEDED_CODE;
 	if (/\b429\b|rate.?limit/i.test(message)) return "RATE_LIMIT";
 	if (/\b413\b|failed to buffer the request body:\s*length limit exceeded|payload too large|request body too large/i.test(message)) return "INVALID_REQUEST";
@@ -2519,7 +2545,18 @@ function directoryEntries(profiles, settingsNs) {
 			...error === void 0 ? {} : { error }
 		});
 	};
-	for (const provider of catalog) declare(provider, provider);
+	/* PawWork patch: restore the 0.1.0-rc.8 directory filter. A catalog provider
+	whose only auth branch is OAuth (today: openai-codex) has nothing this adapter
+	can authenticate with — the harness resolves API keys through ctx.credentials
+	and hands them to pi-ai per request, while an OAuth grant only ever comes from
+	a sign-in flow. rc.1 dropped this filter for the new ctx.authorization seam,
+	and 0.1.5-rc.1 registers a flow per provider through it, but no DSH release
+	yet ships a surface that can start one: dsh-web-app does not mount
+	dsh-authorization and the models settings UI has no sign-in control, so
+	listing such a provider offers an API-key form whose key can never work. Drop
+	this patch once DSH ships that surface and PawWork mounts
+	@deepseek-ai/dsh-authorization. */
+	for (const provider of catalog) if (catalogProvider(provider)?.auth?.apiKey !== void 0) declare(provider, provider);
 	for (const [provider, profile] of profiles) declare(provider, profile.displayName, profile.catalogError);
 	return [...entries.values()];
 }
