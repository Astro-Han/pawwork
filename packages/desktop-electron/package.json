{
  "name": "@pawwork/desktop",
  "private": true,
  "version": "2026.8.3",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://pawwork.ai",
  "author": {
    "name": "PawWork"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "vitest run && pnpm run test:node",
    "test:node": "node --test resources/dsh/home/plugins/automations/automation-cron.test.cjs resources/dsh/home/plugins/automations/automations.test.cjs resources/dsh/home/plugins/import-v1/import-v1-automations.node-test.cjs resources/dsh/home/plugins/import-v1/import-v1-settings.test.cjs resources/dsh/home/plugins/import-v1/import-v1.node-test.cjs resources/dsh/zen-identity.test.cjs",
    "smoke:ci": "tsx ./scripts/ci-smoke.ts",
    "predev": "tsx ./scripts/generate-icons.ts",
    "dev": "electron-vite dev",
    "prebuild": "tsx ./scripts/generate-icons.ts",
    "build": "electron-vite build",
    "package": "tsx ./scripts/prepare-uv.ts && pnpm run build && electron-builder --config electron-builder.config.ts",
    "package:mac": "tsx ./scripts/prepare-uv.ts --platform darwin && pnpm run build && electron-builder --mac --config.mac.notarize=false --config electron-builder.config.ts",
    "package:win": "tsx ./scripts/prepare-uv.ts --platform win32 --arch x64 && pnpm run build && electron-builder --win --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.8",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.8",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.8",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.8",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.8",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.13.9",
    "@types/semver": "7.7.1",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "electron": "41.10.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5",
    "js-yaml": "4.3.1",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "~5.6.2",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
